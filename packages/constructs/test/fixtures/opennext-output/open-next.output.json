{
  "edgeFunctions": {},
  "origins": {
    "s3": {
      "type": "s3",
      "originPath": "/_assets",
      "copy": [
        {
          "from": "opennext-output/assets",
          "to": "_assets",
          "cached": true,
          "versionedSubDir": "_next"
        },
        { "from": "opennext-output/cache", "to": "_cache", "cached": false }
      ]
    },
    "imageOptimizer": {
      "type": "function",
      "handler": "index.handler",
      "bundle": "opennext-output/image-optimization-function",
      "streaming": false,
      "imageLoader": "s3",
      "wrapper": "aws-lambda",
      "converter": "aws-apigw-v2"
    },
    "default": {
      "type": "function",
      "handler": "index.handler",
      "bundle": "opennext-output/server-functions/default",
      "streaming": false,
      "wrapper": "aws-lambda",
      "converter": "aws-apigw-v2",
      "queue": "sqs",
      "incrementalCache": "s3",
      "tagCache": "dynamodb"
    }
  },
  "behaviors": [
    { "pattern": "_next/image*", "origin": "imageOptimizer" },
    { "pattern": "_next/data/*", "origin": "default" },
    { "pattern": "*", "origin": "default" },
    { "pattern": "BUILD_ID", "origin": "s3" },
    { "pattern": "_next/*", "origin": "s3" }
  ],
  "additionalProps": {
    "disableTagCache": false,
    "warmer": { "handler": "index.handler", "bundle": "opennext-output/warmer-function" },
    "revalidationFunction": {
      "handler": "index.handler",
      "bundle": "opennext-output/revalidation-function"
    }
  }
}
