node_modules/
cdk.out/
.turbo/
coverage/
*.tsbuildinfo

# `ssm.StringParameter.valueFromLookup` caches the real SSM value here at
# synth time (NewNotamsStack reads SecureString secrets this way, since
# CloudFormation's ssm-secure dynamic reference does not support Lambda
# environment variables at all — confirmed via a real deploy failure, not
# assumed). Must never be committed.
cdk.context.json

# infrastructure/network is the one exception: ec2.Vpc's constructor calls
# Stack.availabilityZones unconditionally whenever an explicit
# `availabilityZones` prop is given (to validate it against the stack's own
# AZ list) — confirmed by reading aws-cdk-lib's own Vpc and Stack source,
# not assumed. There is no CDK-level way to avoid this live
# ec2:DescribeAvailabilityZones call for a concretely-enviroedstack, which
# broke deploy.yml's dev job (gha-deploy-dev holds only sts:AssumeRole, no
# direct AWS permissions, by design) on a from-scratch CI checkout with no
# pre-existing cache. us-east-1's AZ list is static, authoritative data
# (confirmed against the real account), not live state the way every other
# use of this file's cache is — committing it here is the least-bad option.
!infrastructure/network/cdk.context.json

# Build output only. Do NOT use a bare `lib/` pattern: CDK convention puts stack
# SOURCE in <package>/lib/, so `lib/` silently excludes real code from git.
packages/*/dist/
infrastructure/*/dist/
applications/*/dist/
automation/*/dist/

.env
.env.*
!.env.example
*.log
.DS_Store

# Editor/extension state, not project code
.kilo/

# Scratch commit-message files used to avoid PowerShell quoting issues with
# multi-line -m strings. Accidentally committed once; never again.
.git-commit-msg.txt

# GitHub Packages auth config (references $NODE_AUTH_TOKEN, never the literal
# token itself -- but still machine-local, not committed, same as any .npmrc).
.npmrc
