# Template for .env.local, which holds the real values and is gitignored.
# Account IDs are not secrets, but they are free reconnaissance, so they stay
# out of the repo. See docs/development.md §6.
#
#   Copy-Item .env.example .env.local
#
# In CI these are GitHub repository *variables*, not secrets (.github/workflows/ci.yml).

MGMT_ACCOUNT_ID=<12 digits>
PLATFORM_ACCOUNT_ID=<12 digits>

# Organization identifiers, read back at any time with:
#   aws organizations describe-organization --profile mgmt
#   aws organizations list-roots --profile mgmt
#   aws organizations list-organizational-units-for-parent --parent-id <root id> --profile mgmt
ORGANIZATION_ID=o-xxxxxxxxxx
ROOT_OU_ID=r-xxxx
SECURITY_OU_ID=ou-xxxx-xxxxxxxx
WORKLOADS_OU_ID=ou-xxxx-xxxxxxxx
SANDBOX_OU_ID=ou-xxxx-xxxxxxxx

# Identity Center SSO start URL, from the Identity Center dashboard. QUICKSTART step 3.
SSO_START_URL=https://d-xxxxxxxxxx.awsapps.com/start
